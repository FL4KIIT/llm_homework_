# Copy to .env and fill in your key.
OPENROUTER_API_KEY=your_key_here

# OpenRouter model used for comparison.
# You can replace it with any model available in your OpenRouter account.
OPENROUTER_MODEL=openrouter/free

# Local model paths.
QWEN_MODEL=models/Qwen2.5-3B-Instruct-Q4_K_M.gguf
LLAMA_MODEL=models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
